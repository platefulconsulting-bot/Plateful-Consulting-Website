# ---------------------------------------------------------------------------
# Plateful Consulting — environment configuration
# Copy to `.env` and fill in. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# Public site origin (no trailing slash). Used for canonical URLs, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL="https://platefulconsulting.com"

# Database.
#   Local / VPS / Docker  -> SQLite (default below)
#   Vercel / Netlify      -> Postgres, e.g. Neon or Supabase. Also switch the
#                            `provider` in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Blog Studio admin login (seeded by `npm run db:seed`).
STUDIO_EMAIL="info@platefulconsulting.com"
STUDIO_PASSWORD="change-this-before-going-live"

# Secret used to sign the Studio session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-64-character-random-hex-string"

# Where Studio image uploads are stored. Defaults to ./storage/uploads.
# In Docker, point this at a mounted volume so media survives a redeploy.
UPLOAD_DIR=""

# Where contact-form enquiries are emailed. Leave blank to log to the database only.
RESEND_API_KEY=""
ENQUIRY_TO_EMAIL="info@platefulconsulting.com"
